+#if defined(FBA_IGNORE_ROM_CRC)
+// Match archive paths by basename and ignore case for ROM-set revisions.
+static char rom_ascii_lower(char value)
+{
+   if (value >= 'A' && value <= 'Z')
+      return (char)(value - 'A' + 'a');
+   return value;
+}
+
+static const char* rom_basename(const char *name)
+{
+   const char *slash = strrchr(name, '/');
+   const char *backslash = strrchr(name, '\\');
+   if (backslash && (!slash || backslash > slash))
+      slash = backslash;
+   return slash ? slash + 1 : name;
+}
+
+static bool rom_name_equal(const char *left, const char *right)
+{
+   left = rom_basename(left);
+   right = rom_basename(right);
+   while (*left && *right)
+   {
+      if (rom_ascii_lower(*left) != rom_ascii_lower(*right))
+         return false;
+      left++;
+      right++;
+   }
+   return *left == '\0' && *right == '\0';
+}
+
+static int find_rom_by_name_relaxed(const char *name, const ZipEntry *list, unsigned elems)
+{
+   for (unsigned i = 0; i < elems; i++)
+      if (rom_name_equal(list[i].szName, name))
+         return (int)i;
+   return -1;
+}
+#endif
